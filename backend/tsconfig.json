{
  "compilerOptions": {
    "target": "ES2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "declaration": false
  },
  "include": ["src/**/*"],
  // Tests are run by `node --test` (type stripping, not tsc) and import with
  // explicit .ts extensions, so they are type-checked by tsconfig.test.json
  // instead of being compiled into dist/.
  "exclude": ["node_modules", "dist", "src/**/*.test.mts"]
}
